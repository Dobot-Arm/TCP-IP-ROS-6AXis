<launch>
  <!--Load urdf to param server-->
  <param name="robot_description" command="$(find xacro)/xacro --inorder '$(find dobot_gazebo)/urdf/cr7_robot.xacro'"/>

  <!--Convert JointState to JointTrajectory for Gazebo plugin-->
  <node name="joint_state_to_trajectory" pkg="dobot_gazebo" type="joint_state_to_trajectory.py" output="screen"/>
</launch>
